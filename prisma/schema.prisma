// Chimbo Direct - Marketplace for local market guides in Kariakoo

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  email        String?  @unique // Email for login & social auth
  passwordHash String?  // bcrypt hash for email+password auth
  name         String
  role         String   @default("seeker") // seeker, guide, admin
  status       String   @default("active") // active, suspended
  languagePref String   @default("sw") // sw, en
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guideProfile  GuideProfile?
  seekerRequests Request[]      @relation("SeekerRequests")
  guideSessions  Session[]      @relation("GuideSessions")
  seekerSessions Session[]      @relation("SeekerSessions")
  sentMessages   Message[]      @relation("SentMessages")
  chatSentMessages ChatMessage[] @relation("ChatSentMessages")
  conversationParticipants ConversationParticipant[]
  notifications  Notification[]
  badges         Badge[]
  payouts        Payout[]
}

model GuideProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String   @default("")
  idDocumentUrl  String?
  status         String   @default("pending") // pending, active, suspended
  zones          String   @default("[]") // JSON array of zone IDs
  languages      String   @default("[]") // JSON array of language codes
  avgRating      Float    @default(0)
  reviewCount    Int      @default(0)
  totalSessions  Int      @default(0)
  trendingRating Float    @default(0) // 30-day rolling average
  isOnline       Boolean  @default(false)
  currentStatus  String   @default("offline") // online, offline, busy
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Zone {
  id          String   @id @default(cuid())
  name        String
  nameSw      String   @default("")
  description String   @default("")
  geoBounds   String   @default("{}") // JSON geo-boundaries
  color       String   @default("#4CAF50")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests   Request[]
  vendors    Vendor[]
  priceRadar PriceRadar[]
}

model Request {
  id          String   @id @default(cuid())
  seekerId    String
  description String
  zoneIds     String   @default("[]") // JSON array of zone IDs
  budget      Float    @default(0)
  photoUrl    String?
  status      String   @default("open") // open, matched, active, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seeker   User     @relation("SeekerRequests", fields: [seekerId], references: [id], onDelete: Cascade)
  zones    Zone[]
  sessions Session[]
}

model Session {
  id             String    @id @default(cuid())
  requestId      String
  guideId        String
  seekerId       String
  sessionCode    String    @default("")
  startedAt      DateTime?
  completedAt    DateTime?
  escrowStatus   String    @default("pending") // pending, held, released, refunded, disputed
  amount         Float     @default(0)
  platformFee    Float     @default(0)
  ratingSeeker   Float?
  ratingGuide    Float?
  reviewSeeker   String?
  reviewGuide    String?
  disputeFlag    Boolean   @default(false)
  disputeReason  String?
  emergencyFlag  Boolean   @default(false)
  seekerConfirmed Boolean  @default(false)
  guideConfirmed  Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  request  Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  guide    User     @relation("GuideSessions", fields: [guideId], references: [id])
  seeker   User     @relation("SeekerSessions", fields: [seekerId], references: [id])
  messages Message[]
}

model Message {
  id               String   @id @default(cuid())
  sessionId        String
  senderId         String
  content          String
  translatedContent String?
  createdAt        DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User    @relation("SentMessages", fields: [senderId], references: [id])
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  zoneId      String
  categories  String   @default("[]") // JSON array
  stallNumber String   @default("")
  contact     String   @default("")
  geoLat      Float    @default(-6.8264)
  geoLng      Float    @default(39.2695)
  approved    Boolean  @default(false)
  recommendations Int  @default(0)
  openHours   String   @default("8:00-18:00")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model PriceRadar {
  id         String   @id @default(cuid())
  category   String
  zoneId     String
  priceMin   Float
  priceMax   Float
  updatedAt  DateTime @default(now())
  updatedBy  String   @default("admin")

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model Payout {
  id              String    @id @default(cuid())
  guideId         String
  amount          Float
  status          String    @default("pending") // pending, processed, failed
  mobileMoneyNumber String  @default("")
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  guide User @relation(fields: [guideId], references: [id], onDelete: Cascade)
}

model Badge {
  id        String   @id @default(cuid())
  guideId   String
  badgeType String
  awardedAt DateTime @default(now())

  user User @relation(fields: [guideId], references: [id], onDelete: Cascade)
}

// ── Feature: Vendor Verified Badge (4) ──
model VendorVerification {
  id            String   @id @default(cuid())
  vendorId      String   @unique
  isVerified    Boolean  @default(false)
  verifiedAt    DateTime?
  expiresAt     DateTime?
  monthlyFee    Float    @default(5000)
  qrCode        String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Feature: Guide Subscription Tiers (5) ──
model GuideSubscription {
  id          String    @id @default(cuid())
  guideId     String    @unique
  tier        String    @default("starter") // starter, pro, elite
  startDate   DateTime  @default(now())
  endDate     DateTime?
  autoRenew   Boolean   @default(false)
  paymentRef  String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Feature: Package Deals (6) ──
model PackageDeal {
  id              String   @id @default(cuid())
  guideId         String
  title           String
  description     String   @default("")
  duration        Float    @default(2) // hours
  zoneIds         String   @default("[]") // JSON array
  price           Float    @default(0)
  includesDelivery Boolean @default(false)
  sessionsCompleted Int    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Feature: Live Session Recording (7) ──
model SessionRecording {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  isRecording   Boolean  @default(false)
  guideConsent  Boolean  @default(false)
  seekerConsent Boolean  @default(false)
  duration      Float    @default(0) // seconds
  storageUrl    String   @default("")
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Feature: Buddy System (8) ──
model BuddyMatch {
  id            String   @id @default(cuid())
  seeker1Id     String
  seeker2Id     String
  zoneId        String
  timeSlot      String
  guideId       String?
  status        String   @default("pending") // pending, matched, active, completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Feature: Indoor Navigation Waypoints (10) ──
model NavWaypoint {
  id          String   @id @default(cuid())
  zoneId      String
  label       String
  labelSw     String   @default("")
  qrCode      String   @default("")
  floorPlanX  Float    @default(0)
  floorPlanY  Float    @default(0)
  type        String   @default("junction") // junction, stall, exit, landmark
  directions  String   @default("{}") // JSON: { left: waypointId, right: waypointId, straight: waypointId }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Market Stories (13) ──
model MarketStory {
  id          String   @id @default(cuid())
  guideId     String
  vendorId    String?
  zoneId      String
  title       String
  content     String
  audioUrl    String?
  tags        String   @default("[]") // JSON array
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Guide Mentorship (14) ──
model Mentorship {
  id          String   @id @default(cuid())
  mentorId    String
  menteeId    String
  status      String   @default("active") // active, completed, cancelled
  sessionsDone Int     @default(0)
  sessionsRequired Int @default(5)
  bonusPercent Float   @default(0.03)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Seasonal Calendar (15) ──
model SeasonalEvent {
  id            String   @id @default(cuid())
  title         String
  titleSw       String   @default("")
  description   String   @default("")
  type          String   @default("cultural") // cultural, religious, seasonal, commercial
  startDate     DateTime
  endDate       DateTime?
  affectedZones String   @default("[]") // JSON array of zone IDs
  insiderTip    String   @default("")
  insiderTipSw  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Feature: Fraud Detection (20) ──
model FraudAlert {
  id          String   @id @default(cuid())
  entityType  String   @default("guide") // guide, seeker, vendor
  entityId    String
  alertType   String   @default("fast_completion") // fast_completion, serial_disputer, recommendation_spike, rating_manipulation
  confidence  Float    @default(0)
  details     String   @default("{}") // JSON
  status      String   @default("pending") // pending, investigated, dismissed, actioned
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Exchange Rates (18) ──
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique // USD, EUR, KES, UGX
  rate      Float    // rate to TZS
  updatedAt DateTime @updatedAt
}

// ── Feature: Group Tour Mode ──
model GroupTour {
  id              String   @id @default(cuid())
  guideId         String
  zoneId          String
  title           String
  description     String   @default("")
  descriptionSw   String   @default("")
  maxParticipants Int      @default(5)
  currentCount    Int      @default(1)
  soloPrice       Float    @default(15000)
  groupPrice      Float    @default(8000)
  timeSlot        String   @default("") // e.g. "09:00-11:00"
  date            String   @default("") // ISO date string
  status          String   @default("open") // open, full, cancelled, completed
  participantIds  String   @default("[]") // JSON array of user IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Feature: Shopping List ──
model ShoppingList {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("My Shopping List")
  items       String   @default("[]") // JSON array of { name, quantity, price, category, zone, purchased }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Digital Wallet ──
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  currency  String   @default("TZS")
  pinHash   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

// ── Feature: Transactions ──
model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String   // deposit, withdrawal, payment, refund, subscription, payout, escrow_hold, escrow_release, escrow_refund
  amount      Float
  status      String   @default("pending") // pending, completed, failed, escrow, disputed
  description String   @default("")
  reference   String   @default("")
  provider    String?  // pesapal, stripe, paypal, escrow
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([status])
}

// ── Feature: Notifications ──
model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   @default("info") // info, success, warning, error, session, payment, system, booking, message, review, alert
  title      String
  titleSw    String?
  message    String
  bodySw     String?
  read       Boolean  @default(false)
  actionUrl  String?
  imageUrl   String?
  createdAt  DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ── Feature: User Security ──
model UserSecurity {
  id              String    @id @default(cuid())
  userId          String    @unique
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  twoFactorBackupCodes String? // JSON array of backup code hashes
  pinEnabled       Boolean  @default(false)
  pinHash          String?
  loginAttempts    Int      @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  sessionTimeout   Int      @default(30) // minutes
  profileVisible   Boolean  @default(true)
  showPhone        Boolean  @default(false)
  showEmail        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  authSessions UserAuthSession[]
}

// ── Feature: User Auth Sessions (for device/session tracking) ──
model UserAuthSession {
  id          String   @id @default(cuid())
  userId      String
  deviceName  String   @default("Unknown Device")
  deviceType  String   @default("other") // mobile, desktop, tablet, other
  browser     String   @default("")
  os          String   @default("")
  location    String   @default("")
  ipAddress   String   @default("")
  isCurrent   Boolean  @default(false)
  lastActive  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user UserSecurity @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

// ── Feature: Reviews ──
model Review {
  id          String   @id @default(cuid())
  sessionId   String
  reviewerId  String
  revieweeId  String
  rating      Float
  comment     String   @default("")
  response    String?  // Guide's response to the review
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([revieweeId])
  @@index([reviewerId])
}

// ── Feature: Calendar Reminders ──
model CalendarReminder {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

// ── Feature: Real-time Chat ──
model Conversation {
  id           String   @id @default(cuid())
  bookingId    String?  // optional link to a booking/session
  lastMessageAt DateTime @default(now())
  lastMessageContent String @default("")
  lastMessageSender  String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participants ConversationParticipant[]
  chatMessages ChatMessage[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  unreadCount    Int      @default(0)
  lastReadAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id               String   @id @default(cuid())
  conversationId   String
  senderId         String
  messageType      String   @default("text") // text, image, location, system
  content          String
  imageUrl         String?
  latitude         Float?
  longitude        Float?
  translatedContent String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User        @relation("ChatSentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
}

// ── Feature: Payment Methods ──
model PaymentMethod {
  id         String   @id @default(cuid())
  userId     String
  provider   String   // pesapal, stripe, paypal
  providerId String?  // Stripe payment method ID, PayPal email, etc.
  label      String   // "Visa ****4242", "PayPal (john@example.com)", "M-Pesa 0712***678"
  isDefault  Boolean  @default(false)
  metadata   String   @default("{}") // JSON: last4, brand, etc.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ── Feature: Referral System (9) ──
model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  refereeId   String?
  code        String    @unique
  status      String    @default("pending") // pending, converted, rewarded
  reward      Float     @default(0)
  createdAt   DateTime  @default(now())
  convertedAt DateTime?

  @@index([referrerId])
  @@index([code])
}

// ── Feature: Dispute Resolution (10) ──
model Dispute {
  id          String    @id @default(cuid())
  sessionId   String
  filedBy     String
  against     String
  category    String    @default("other") // service_quality, no_show, overcharging, safety_concern, other
  description String    @default("")
  evidence    String    @default("[]") // JSON array of evidence URLs/descriptions
  status      String    @default("open") // open, under_review, resolved
  resolution  String?   // refund, partial_refund, no_action
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([filedBy])
  @@index([against])
  @@index([status])
}

// ── Feature: Favorites & Bookmarks (8) ──
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  targetId   String
  targetType String   // guide, vendor, package, zone
  collection String   @default("default") // folder/collection name
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@unique([userId, targetId, targetType, collection])
  @@index([userId])
  @@index([targetId, targetType])
  @@index([userId, collection])
}

// ── Feature: Guide Verification (5) ──
model GuideVerification {
  id               String    @id @default(cuid())
  guideId          String    @unique
  status           String    @default("not_submitted") // not_submitted, pending, under_review, approved, rejected
  fullName         String    @default("")
  idNumber         String    @default("")
  address          String    @default("")
  quizScore        Int       @default(0)
  quizTotal        Int       @default(5)
  selfieUrl        String?
  documentFrontUrl String?
  documentBackUrl  String?
  addressProofUrl  String?
  backgroundCheckStatus String @default("not_started") // not_started, in_progress, passed, failed
  rejectionReason  String?
  reviewedBy       String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([guideId])
}

// ── Feature: Location History (6) ──
model LocationHistory {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  lat       Float
  lng       Float
  accuracy  Float    @default(10)
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([userId, timestamp])
}

// ── Feature: Review Moderation (17) ──
model ReviewModeration {
  id               String    @id @default(cuid())
  reviewId         String
  status           String    @default("pending") // pending, approved, rejected
  reason           String    @default("") // auto-flag reason or rejection reason
  moderatedBy      String?
  moderatedAt      DateTime?
  officialResponse  String?
  flaggedBy        String    @default("system") // system, user_id
  flagReason       String    @default("") // profanity, short_review, extreme_rating, spam, inappropriate
  aiConfidence     Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([reviewId])
  @@index([status])
  @@index([moderatedBy])
}

// ── Feature: Review Reports (17) ──
model ReviewReport {
  id          String   @id @default(cuid())
  reviewId    String
  reporterId  String
  reason      String   @default("") // inappropriate, spam, fake, offensive, other
  details     String   @default("")
  status      String   @default("pending") // pending, reviewed, dismissed
  createdAt   DateTime @default(now())

  @@index([reviewId])
  @@index([reporterId])
  @@index([status])
}

// ── Feature: Fraud Log (18) ──
model FraudLog {
  id          String   @id @default(cuid())
  alertId     String?
  entityType  String   @default("guide") // guide, seeker, vendor
  entityId    String
  action      String   // investigate, dismiss, suspend, ban, auto_suspend
  reason      String   @default("")
  performedBy String?  // admin user id or "system"
  details     String   @default("{}") // JSON
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([alertId])
  @@index([createdAt])
}

// ── Feature: Fraud Risk Score (18) ──
model FraudRiskScore {
  id          String   @id @default(cuid())
  userId      String   @unique
  riskScore   Int      @default(0) // 0-100
  riskLevel   String   @default("low") // low, medium, high, critical
  factors     String   @default("{}") // JSON: breakdown of risk factors
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([riskLevel])
  @@index([riskScore])
}

// ── Feature: Session Milestones (19) ──
model SessionMilestone {
  id          String   @id @default(cuid())
  sessionId   String
  type        String   // meetup, zone_change, vendor_visit, checkpoint, break, end
  label       String   @default("")
  lat         Float?
  lng         Float?
  zoneId      String?
  vendorId    String?
  metadata    String   @default("{}") // JSON: extra info
  timestamp   DateTime @default(now())

  @@index([sessionId])
  @@index([timestamp])
}

// ── Feature: Session Notes (19) ──
model SessionNote {
  id          String   @id @default(cuid())
  sessionId   String
  guideId     String
  content     String
  isPrivate   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sessionId])
  @@index([guideId])
}

// ── Feature: Rating History (16) ──
model RatingHistory {
  id          String   @id @default(cuid())
  guideId     String
  rating      Float
  reviewId    String?
  avgRating   Float    // snapshot of avg at this point
  reviewCount Int      // snapshot of total reviews at this point
  createdAt   DateTime @default(now())

  @@index([guideId])
  @@index([createdAt])
}

// ── Feature: Badge Definitions (24) ──
model BadgeDefinition {
  id          String   @id @default(cuid())
  key         String   @unique // first_booking, five_sessions, etc.
  name        String
  description String   @default("")
  icon        String   @default("") // emoji or icon name
  category    String   @default("seeker") // seeker, guide, both
  threshold   Int      @default(1) // e.g. 5 sessions for five_sessions
  tier        String   @default("bronze") // bronze, silver, gold
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Subscription Features (25) ──
model SubscriptionFeature {
  id          String   @id @default(cuid())
  tier        String   // free, pro, elite
  featureKey  String   // unlimited_sessions, advanced_analytics, etc.
  featureName String
  limit       Int      @default(-1) // -1 = unlimited
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tier, featureKey])
}

// ── Feature: QR Check-In (21) ──
model QRCheckIn {
  id          String    @id @default(cuid())
  sessionId   String
  seekerId    String
  guideId     String
  qrCodeHash  String    @unique
  checkedIn   Boolean   @default(false)
  checkedOut  Boolean   @default(false)
  checkedInAt DateTime?
  checkedOutAt DateTime?
  validDate   String    @default("") // ISO date string - QR only valid on this date
