// Kariako Guide - Marketplace for local market guides in Kariakoo

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  email        String?  // Optional, for social login
  name         String
  role         String   @default("seeker") // seeker, guide, admin
  languagePref String   @default("sw") // sw, en
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guideProfile  GuideProfile?
  seekerRequests Request[]      @relation("SeekerRequests")
  guideSessions  Session[]      @relation("GuideSessions")
  seekerSessions Session[]      @relation("SeekerSessions")
  sentMessages   Message[]      @relation("SentMessages")
  badges         Badge[]
  payouts        Payout[]
}

model GuideProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String   @default("")
  idDocumentUrl  String?
  status         String   @default("pending") // pending, active, suspended
  zones          String   @default("[]") // JSON array of zone IDs
  languages      String   @default("[]") // JSON array of language codes
  avgRating      Float    @default(0)
  totalSessions  Int      @default(0)
  isOnline       Boolean  @default(false)
  currentStatus  String   @default("offline") // online, offline, busy
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Zone {
  id          String   @id @default(cuid())
  name        String
  nameSw      String   @default("")
  description String   @default("")
  geoBounds   String   @default("{}") // JSON geo-boundaries
  color       String   @default("#4CAF50")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests   Request[]
  vendors    Vendor[]
  priceRadar PriceRadar[]
}

model Request {
  id          String   @id @default(cuid())
  seekerId    String
  description String
  zoneIds     String   @default("[]") // JSON array of zone IDs
  budget      Float    @default(0)
  photoUrl    String?
  status      String   @default("open") // open, matched, active, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seeker   User     @relation("SeekerRequests", fields: [seekerId], references: [id], onDelete: Cascade)
  zones    Zone[]
  sessions Session[]
}

model Session {
  id             String    @id @default(cuid())
  requestId      String
  guideId        String
  seekerId       String
  sessionCode    String    @default("")
  startedAt      DateTime?
  completedAt    DateTime?
  escrowStatus   String    @default("pending") // pending, held, released, refunded, disputed
  amount         Float     @default(0)
  platformFee    Float     @default(0)
  ratingSeeker   Float?
  ratingGuide    Float?
  reviewSeeker   String?
  reviewGuide    String?
  disputeFlag    Boolean   @default(false)
  disputeReason  String?
  emergencyFlag  Boolean   @default(false)
  seekerConfirmed Boolean  @default(false)
  guideConfirmed  Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  request  Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  guide    User     @relation("GuideSessions", fields: [guideId], references: [id])
  seeker   User     @relation("SeekerSessions", fields: [seekerId], references: [id])
  messages Message[]
}

model Message {
  id               String   @id @default(cuid())
  sessionId        String
  senderId         String
  content          String
  translatedContent String?
  createdAt        DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User    @relation("SentMessages", fields: [senderId], references: [id])
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  zoneId      String
  categories  String   @default("[]") // JSON array
  stallNumber String   @default("")
  contact     String   @default("")
  geoLat      Float    @default(-6.8264)
  geoLng      Float    @default(39.2695)
  approved    Boolean  @default(false)
  recommendations Int  @default(0)
  openHours   String   @default("8:00-18:00")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model PriceRadar {
  id         String   @id @default(cuid())
  category   String
  zoneId     String
  priceMin   Float
  priceMax   Float
  updatedAt  DateTime @default(now())
  updatedBy  String   @default("admin")

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model Payout {
  id              String    @id @default(cuid())
  guideId         String
  amount          Float
  status          String    @default("pending") // pending, processed, failed
  mobileMoneyNumber String  @default("")
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  guide User @relation(fields: [guideId], references: [id], onDelete: Cascade)
}

model Badge {
  id        String   @id @default(cuid())
  guideId   String
  badgeType String
  awardedAt DateTime @default(now())

  user User @relation(fields: [guideId], references: [id], onDelete: Cascade)
}

// ── Feature: Vendor Verified Badge (4) ──
model VendorVerification {
  id            String   @id @default(cuid())
  vendorId      String   @unique
  isVerified    Boolean  @default(false)
  verifiedAt    DateTime?
  expiresAt     DateTime?
  monthlyFee    Float    @default(5000)
  qrCode        String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Feature: Guide Subscription Tiers (5) ──
model GuideSubscription {
  id          String    @id @default(cuid())
  guideId     String    @unique
  tier        String    @default("starter") // starter, pro, elite
  startDate   DateTime  @default(now())
  endDate     DateTime?
  autoRenew   Boolean   @default(false)
  paymentRef  String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Feature: Package Deals (6) ──
model PackageDeal {
  id              String   @id @default(cuid())
  guideId         String
  title           String
  description     String   @default("")
  duration        Float    @default(2) // hours
  zoneIds         String   @default("[]") // JSON array
  price           Float    @default(0)
  includesDelivery Boolean @default(false)
  sessionsCompleted Int    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Feature: Live Session Recording (7) ──
model SessionRecording {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  isRecording   Boolean  @default(false)
  guideConsent  Boolean  @default(false)
  seekerConsent Boolean  @default(false)
  duration      Float    @default(0) // seconds
  storageUrl    String   @default("")
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Feature: Buddy System (8) ──
model BuddyMatch {
  id            String   @id @default(cuid())
  seeker1Id     String
  seeker2Id     String
  zoneId        String
  timeSlot      String
  guideId       String?
  status        String   @default("pending") // pending, matched, active, completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Feature: Indoor Navigation Waypoints (10) ──
model NavWaypoint {
  id          String   @id @default(cuid())
  zoneId      String
  label       String
  labelSw     String   @default("")
  qrCode      String   @default("")
  floorPlanX  Float    @default(0)
  floorPlanY  Float    @default(0)
  type        String   @default("junction") // junction, stall, exit, landmark
  directions  String   @default("{}") // JSON: { left: waypointId, right: waypointId, straight: waypointId }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Market Stories (13) ──
model MarketStory {
  id          String   @id @default(cuid())
  guideId     String
  vendorId    String?
  zoneId      String
  title       String
  content     String
  audioUrl    String?
  tags        String   @default("[]") // JSON array
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Guide Mentorship (14) ──
model Mentorship {
  id          String   @id @default(cuid())
  mentorId    String
  menteeId    String
  status      String   @default("active") // active, completed, cancelled
  sessionsDone Int     @default(0)
  sessionsRequired Int @default(5)
  bonusPercent Float   @default(0.03)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Seasonal Calendar (15) ──
model SeasonalEvent {
  id            String   @id @default(cuid())
  title         String
  titleSw       String   @default("")
  description   String   @default("")
  type          String   @default("cultural") // cultural, religious, seasonal, commercial
  startDate     DateTime
  endDate       DateTime?
  affectedZones String   @default("[]") // JSON array of zone IDs
  insiderTip    String   @default("")
  insiderTipSw  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Feature: Fraud Detection (20) ──
model FraudAlert {
  id          String   @id @default(cuid())
  entityType  String   @default("guide") // guide, seeker, vendor
  entityId    String
  alertType   String   @default("fast_completion") // fast_completion, serial_disputer, recommendation_spike, rating_manipulation
  confidence  Float    @default(0)
  details     String   @default("{}") // JSON
  status      String   @default("pending") // pending, investigated, dismissed, actioned
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Exchange Rates (18) ──
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique // USD, EUR, KES, UGX
  rate      Float    // rate to TZS
  updatedAt DateTime @updatedAt
}

// ── Feature: Group Tour Mode ──
model GroupTour {
  id              String   @id @default(cuid())
  guideId         String
  zoneId          String
  title           String
  description     String   @default("")
  descriptionSw   String   @default("")
  maxParticipants Int      @default(5)
  currentCount    Int      @default(1)
  soloPrice       Float    @default(15000)
  groupPrice      Float    @default(8000)
  timeSlot        String   @default("") // e.g. "09:00-11:00"
  date            String   @default("") // ISO date string
  status          String   @default("open") // open, full, cancelled, completed
  participantIds  String   @default("[]") // JSON array of user IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Feature: Shopping List ──
model ShoppingList {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("My Shopping List")
  items       String   @default("[]") // JSON array of { name, quantity, price, category, zone, purchased }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Feature: Calendar Reminders ──
model CalendarReminder {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}
